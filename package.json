{
  "name": "straits",
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time geopolitical intelligence dashboard for Middle East maritime oil flows",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "verify:fleet": "node scripts/verify-fleet-layout.mjs",
    "verify:dashboard": "node scripts/verify-dashboard-layout.mjs",
    "verify": "npm run verify:fleet && npm run verify:dashboard",
    "check": "npm run lint && npm run typecheck && npm run test:ci",
    "ci": "npm run check && npm run build",
    "ingester": "tsx --env-file=.env.local src/services/ais-ingester/index.ts",
    "ingester:dev": "tsx watch --env-file=.env.local src/services/ais-ingester/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randyren278/straits.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/randyren278/straits/issues"
  },
  "homepage": "https://github.com/randyren278/straits#readme",
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.1",
    "jose": "^6.2.9",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.1.6",
    "node-cron": "^4.6.0",
    "papaparse": "^5.6.0",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcrypt": "^6.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.4",
